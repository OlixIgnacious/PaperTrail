# PaperTrail Environment Variables Template
# Copy this file to .env and provide your API keys

# Gemini Flash (Google AI Studio - Free Tier)
# Model used for generation and embeddings (gemini-embedding-001)
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI (La Plateforme Experiment Tier - Free Tier)
# Model used for Layer 2 Verifier cross-checks
MISTRAL_API_KEY=your_mistral_api_key_here

# Supabase Configuration
# Database: Supabase Postgres + pgvector (free tier)
# Backend compute: Supabase Edge Functions
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# WhatsApp Cloud API (Sandbox / Test Mode)
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# Environment
NODE_ENV=development
PORT=5173
